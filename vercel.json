{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://motos-racing-backend.onrender.com/api/:path*"
    },
    {
      "source": "/:path((?!api|assets|favicon|logo|src).*)",
      "destination": "/src/pages/:path.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
