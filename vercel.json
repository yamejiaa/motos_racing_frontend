{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://motos-racing-backend.onrender.com/api/:path*"
    },
    {
      "source": "/login",
      "destination": "/src/pages/login.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
